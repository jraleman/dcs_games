text = "PLAYER 1"

[node name="Controls" type="Label" parent="Margins/Layout/Card/Layout/ControlGrid/PlayerOneCard/Layout"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Keyboard: 1, 2, 3\nMouse/touch: select blue triangles"
