[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/menus/credits.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://ui/components/background.tscn" id="2_background"]

[node name="Credits" type="Control"]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")
first_focus = NodePath("Margins/Layout/Header/BackButton")
back_scene = "res://scenes/menus/main_menu.tscn"
margins = NodePath("Margins")

[node name="Background" parent="." instance=ExtResource("2_background")]

[node name="Margins" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 1
theme_override_constants/margin_left = 134
theme_override_constants/margin_top = 54
theme_override_constants/margin_right = 134
theme_override_constants/margin_bottom = 54

[node name="Layout" type="VBoxContainer" parent="Margins"]
layout_mode = 2
theme_override_constants/separation = 28

[node name="Header" type="HBoxContainer" parent="Margins/Layout"]
layout_mode = 2
theme_override_constants/separation = 24

[node name="Title" type="Label" parent="Margins/Layout/Header"]
theme_type_variation = &"MenuHeading"
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 1
theme_override_colors/font_color = Color(0.94902, 0.968627, 0.976471, 1)
theme_override_font_sizes/font_size = 56
text = "Credits"
vertical_alignment = 1

[node name="BackButton" type="Button" parent="Margins/Layout/Header"]
metadata/ui_sound_handled = true
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 4
text = "Back"

[node name="Card" type="PanelContainer" parent="Margins/Layout"]
layout_mode = 2
size_flags_vertical = 3

[node name="Scroll" type="ScrollContainer" parent="Margins/Layout/Card"]
unique_name_in_owner = true
layout_mode = 2
follow_focus = true
horizontal_scroll_mode = 0

[node name="List" type="VBoxContainer" parent="Margins/Layout/Card/Scroll"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="Hint" type="Label" parent="Margins/Layout"]
layout_mode = 2
theme_override_colors/font_color = Color(0.454902, 0.529412, 0.568627, 1)
theme_override_font_sizes/font_size = 22
text = "Scroll to read at your own pace"
horizontal_alignment = 1

[connection signal="pressed" from="Margins/Layout/Header/BackButton" to="." method="_on_back_pressed"]
