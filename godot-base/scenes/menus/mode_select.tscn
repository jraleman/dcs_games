layout_mode = 2
theme_override_constants/separation = 10

[node name="Caption" type="Label" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector"]
layout_mode = 2
theme_type_variation = &"SetupSectionLabel"
text = "Who plays as Player 2?"
uppercase = true

[node name="OpponentOptions" type="BoxContainer" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 12

[node name="HumanOptionButton" type="Button" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/OpponentOptions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SetupChoice"
toggle_mode = true
button_group = SubResource("ButtonGroup_opponent")
text = "A Second Player"
text_overrun_behavior = 3

[node name="CpuOptionButton" type="Button" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/OpponentOptions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 66)
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"SetupChoice"
toggle_mode = true
button_pressed = true
button_group = SubResource("ButtonGroup_opponent")
text = "The CPU"
text_overrun_behavior = 3

[node name="OpponentChoiceHint" type="Label" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SetupBody"
theme_override_font_sizes/font_size = 20
text = "Player 2 is driven by the CPU."
autowrap_mode = 3

[node name="CpuDifficultyPanel" type="VBoxContainer" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/separation = 10

[node name="Caption" type="Label" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/CpuDifficultyPanel"]
layout_mode = 2
theme_type_variation = &"SetupSectionLabel"
text = "CPU difficulty"
uppercase = true

[node name="CpuDifficulty" type="OptionButton" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/CpuDifficultyPanel"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 76)
layout_mode = 2
theme_type_variation = &"SetupRow"
text_overrun_behavior = 3
fit_to_longest_item = false

[node name="ConfirmHint" type="Label" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"SetupBody"
theme_override_font_sizes/font_size = 20
text = "Player 1 uses keys 1, 2 and 3."
autowrap_mode = 3

[node name="SetupStage" type="Control" parent="Margins/Layout/Stage/ConfirmStep/Layout/Body"]
unique_name_in_owner = true
visible = false
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
mouse_filter = 2
script = ExtResource("3_stage")

[node name="Actions" type="HBoxContainer" parent="Margins/Layout/Stage/ConfirmStep/Layout"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 18
alignment = 2

[node name="PreviousButton" type="Button" parent="Margins/Layout/Stage/ConfirmStep/Layout/Actions"]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_type_variation = &"NavigationButton"
text = "Change Mode"

[node name="ConfirmButton" type="Button" parent="Margins/Layout/Stage/ConfirmStep/Layout/Actions"]
unique_name_in_owner = true
custom_minimum_size = Vector2(400, 0)
layout_mode = 2
theme_type_variation = &"AccentButton"
text = "Start Single Player"
icon = ExtResource("11_arrow")
icon_alignment = 2

[connection signal="pressed" from="Margins/Layout/Header/BackButton" to="." method="_on_back_pressed"]
[connection signal="toggled" from="Margins/Layout/Header/DetailsButton" to="." method="_update_details_visibility"]
[connection signal="pressed" from="Margins/Layout/Stage/SelectionStep/Layout/ModeGrid/SinglePlayer/SinglePlayerButton" to="." method="_on_single_player_pressed"]
[connection signal="pressed" from="Margins/Layout/Stage/SelectionStep/Layout/ModeGrid/Multiplayer/MultiplayerButton" to="." method="_on_multiplayer_pressed"]
[connection signal="pressed" from="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/OpponentOptions/HumanOptionButton" to="." method="_on_opponent_option_pressed"]
[connection signal="pressed" from="Margins/Layout/Stage/ConfirmStep/Layout/Body/Setup/SetupScroll/SetupColumn/OpponentSelector/OpponentOptions/CpuOptionButton" to="." method="_on_opponent_option_pressed"]
[connection signal="pressed" from="Margins/Layout/Stage/ConfirmStep/Layout/Actions/PreviousButton" to="." method="_on_previous_pressed"]
[connection signal="pressed" from="Margins/Layout/Stage/ConfirmStep/Layout/Actions/ConfirmButton" to="." method="_on_confirm_pressed"]
