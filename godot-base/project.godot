; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="DCS Base Game"
config/description="Base Godot project for DeskCanSaw Games: studio logo, intro, main menu, settings and credits."
config/version="0.1.0"
run/main_scene="res://scenes/boot/studio_logo.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="DeskCanSaw Games/DCS Base Game"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.686275, 0.866667, 0.917647, 1)
boot_splash/show_image=false
config/icon="res://icon.svg"
config/name.dmj="Dead Metal Jam"
config/custom_user_dir_name.dmj="DeskCanSaw Games/Dead Metal Jam"
config/name.tr="Triangle Rush"
config/custom_user_dir_name.tr="DeskCanSaw Games/Target Rush"
config/name.dcs="Desk-Can-Saw"
config/custom_user_dir_name.dcs="DeskCanSaw Games/Desk-Can-Saw"
config/name.cp="Chicken Pit"
config/custom_user_dir_name.cp="DeskCanSaw Games/Chicken Pit"
config/name.lazer_nfc="LaZer NFC"
config/custom_user_dir_name.lazer_nfc="DeskCanSaw Games/LaZer NFC"
config/name.antichess="Anti-Chess"
config/custom_user_dir_name.antichess="DeskCanSaw Games/Anti-Chess"
config/name.anticheckers="Anti Checkers"
config/custom_user_dir_name.anticheckers="DeskCanSaw Games/Anti Checkers"

[audio]

driver/enable_input=true
driver/enable_input.lazer_nfc=false
general/text_to_speech=true
driver/mix_rate.lazer_nfc=44100
driver/output_latency.lazer_nfc=15

[autoload]

Settings="*res://autoload/settings.gd"
AudioManager="*res://autoload/audio_manager.gd"
Router="*res://autoload/router.gd"
GameSession="*res://autoload/game_session.gd"
AchievementManager="*res://autoload/achievement_manager.gd"
Store="*res://autoload/store.gd"
ShareManager="*res://autoload/share_manager.gd"

[dcs]

build/single_game_id="desk_can_saw"
build/single_game_id.collection=""
build/single_game_id.dmj="dead_metal_jam"
build/single_game_id.tr="triangle_rush"
build/single_game_id.dcs="desk_can_saw"
build/single_game_id.cp="chicken_pit"
build/single_game_id.lazer_nfc="lazer_nfc"
build/single_game_id.antichess="anti_chess"
build/single_game_id.anticheckers="anti_checkers"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/viewport_width.lazer_nfc=720
window/size/viewport_height.lazer_nfc=1280
window/size/window_width_override.lazer_nfc=540
window/size/window_height_override.lazer_nfc=960
window/handheld/orientation.lazer_nfc=1

[editor]

movie_writer/fps=30
movie_writer/mjpeg_quality=0.95

[editor_plugins]

enabled=PackedStringArray("res://games/lazer_nfc/android/plugin.cfg")

[gui]

theme/custom="res://ui/theme/dcs_theme.tres"

