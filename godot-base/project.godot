[input_devices]

sensors/enable_accelerometer.lazer_nfc=true
sensors/enable_gravity.lazer_nfc=true
sensors/enable_gyroscope.lazer_nfc=false
sensors/enable_magnetometer.lazer_nfc=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
environment/defaults/default_clear_color=Color(0.054902, 0.082353, 0.098039, 1)
textures/vram_compression/import_etc2_astc=true

[share]

stats_urls/triangle_rush="https://deskcansaw.com/stats/tr"
stats_urls/desk_can_saw="https://deskcansaw.com/stats/dcs"
stats_urls/chicken_pit="https://deskcansaw.com/stats/cp"
stats_urls/lazer_nfc="https://deskcansaw.com/stats/lz"
